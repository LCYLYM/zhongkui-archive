{
  "schema": 1,
  "schedule": {
    "timezone": "Asia/Shanghai",
    "cron": "17 8 * * *"
  },
  "model": {
    "provider": "nvidia-nim",
    "id": "deepseek-ai/deepseek-v4-flash-0731",
    "baseUrl": "https://integrate.api.nvidia.com/v1",
    "contextWindow": 280000,
    "maxTokens": 16384,
    "stream": true,
    "temperature": 0.2,
    "topP": 0.95
  },
  "search": {
    "exaMcpUrl": "https://mcp.exa.ai/mcp"
  },
  "limits": {
    "minSearches": 12,
    "maxSearches": 200,
    "synthesisAtSearches": 180,
    "maxNewItems": 10,
    "maxVideoContexts": 8,
    "maxEvidenceCharsPerSearch": 1800,
    "maxTranscriptCharsPerVideo": 2500,
    "maxPromptBytes": 110000,
    "maxCny": 10,
    "maxWallMinutes": 60,
    "maxModelMinutes": 30,
    "maxChangedFiles": 3
  },
  "contentPolicy": {
    "videoPrimaryToCrossRatio": 2,
    "maxYoutubeItemsPerCreatorPerRun": 1
  },
  "pricing": {
    "currency": "CNY",
    "unit": "per_million_tokens",
    "basis": "conservative-shadow-budget",
    "inputCacheHit": 0.1,
    "inputCacheMiss": 3,
    "output": 9
  },
  "paths": {
    "report": ".automation/report.json",
    "entries": "content/entries/automated",
    "state": "content/state.json",
    "generated": "src/data/automated-content.json"
  }
}
