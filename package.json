{
  "name": "zhongkui-archive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "content:build": "node scripts/build-content.mjs",
    "content:validate": "node scripts/verify-content-update.mjs --all",
    "privacy:check": "node scripts/privacy-scan.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run content:build && npm run content:validate && npm run privacy:check && npm test && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.0",
    "vite": "8.2.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {}
}
