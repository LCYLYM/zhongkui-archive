{
  "name": "zhongkui-archive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "content:build": "node scripts/build-content.mjs",
    "content:validate": "node scripts/verify-content-update.mjs --all",
    "model:optimize": "node scripts/optimize-character.mjs",
    "privacy:check": "node scripts/privacy-scan.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run content:build && npm run content:validate && npm run privacy:check && npm test && npm run build && npm run site:validate",
    "site:validate": "node scripts/verify-site.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "meshoptimizer": "^1.2.0",
    "sharp": "^0.35.4"
  }
}
